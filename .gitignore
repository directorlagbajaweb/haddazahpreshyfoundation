# .gitignore
# IDE and Editor Files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store

# Node modules (if you decide to add build tools later)
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
*.map

# Environment variables
.env
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
Thumbs.db
.DS_Store

# Backup files
*.bak
*.backup
*.tmp

# Dependencies
vendor/

# Cache
.cache/
*.cache

# Testing
coverage/
.nyc_output/
